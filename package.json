{
  "name": "safety-car",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --env-file .env.local",
    "check": "tsc --noEmit",
    "plan": "alchemy plan --stage prod --env-file .env.production",
    "deploy": "alchemy deploy --stage prod --env-file .env.production",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "pnpm dlx auth@latest generate --config ./src/lib/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.26",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.36",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@effect/platform-node": "4.0.0-beta.103",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "alchemy": "2.0.0-beta.67",
    "drizzle-kit": "^0.31.10",
    "effect": "4.0.0-beta.103",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
