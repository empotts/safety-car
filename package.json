{
  "name": "safety-car",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --env-file .env.local",
    "check": "tsc --noEmit",
    "plan": "alchemy plan --stage prod --env-file .env.production",
    "deploy": "alchemy deploy --stage prod --env-file .env.production",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "pnpm dlx auth@latest generate --config ./src/lib/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@effect/platform-node": "4.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "alchemy": "2.0.0-beta.81",
    "drizzle-kit": "^0.31.11",
    "effect": "4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
