{
  "name": "safety-car",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --env-file .env.local",
    "check": "tsc --noEmit",
    "plan": "alchemy plan --stage prod --env-file .env.production",
    "deploy": "alchemy deploy --stage prod --env-file .env.production",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "pnpm dlx auth@latest generate --config ./src/lib/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.25",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.32",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "@effect/platform-node": "4.0.0-beta.101",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "alchemy": "2.0.0-beta.64",
    "drizzle-kit": "^0.31.10",
    "effect": "4.0.0-beta.101",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
