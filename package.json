{
  "name": "safety-car",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --env-file .env.local",
    "check": "tsc --noEmit",
    "plan": "alchemy plan --stage prod --env-file .env.production",
    "deploy": "alchemy deploy --stage prod --env-file .env.production",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "pnpm dlx auth@latest generate --config ./src/lib/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.60",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@effect/platform-node": "4.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "alchemy": "2.0.0-beta.87",
    "drizzle-kit": "^0.31.11",
    "effect": "4.1.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "pnpm": {
    "overrides": {
      "undici@7": ">=7.30.1 <8",
      "undici@8": ">=8.12.2 <9",
      "seroval@1.6": ">=1.6.11 <1.7",
      "zod@4": ">=4.6.6 <5",
      "toml@4": ">=5.0.1 <6",
      "esbuild@0.18.20": "0.25.12"
    }
  }
}
